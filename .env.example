# ---- Core ----
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# ---- Database (Postgres) ----
DATABASE_URL=postgresql://pinpoint:pinpoint@localhost:5432/pinpoint?schema=public

# ---- Redis (BullMQ + socket adapter + rate limit) ----
# Leave empty to run without Redis: inline queue driver, in-memory socket fan-out
# and in-memory rate limiting are used instead. Set it for the full stack.
REDIS_URL=redis://localhost:6379

# ---- AI ----
# Leave empty to use the deterministic mock provider (no network, no key needed).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_CACHE_TTL_SECONDS=86400

# ---- Storage ----
# local | cloudinary
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
PUBLIC_API_URL=http://localhost:4000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Limits ----
MAX_UPLOAD_MB=10
MAX_PAGES_PER_TOPIC=2
